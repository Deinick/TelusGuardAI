# Copy to .env and fill. .env is gitignored.

# Optional: override data paths (defaults: PROJECT_ROOT/data/...)
# PROJECT_ROOT=
# ZENODO_BASE=
# TOWERS_JSON=

# NetOps: default tower limit for /api (default 2000; use 0 or leave unset to use 2000)
# NETOPS_TOWER_LIMIT=2000

# AI (Network Impact Analyzer) – required for agents
# GEMMA_TOKEN=
# DEEPSEEK_TOKEN=
# GPT_TOKEN=
# QWEN_CODER_TOKEN=
# QWEN_EMB_TOKEN=

# Optional endpoint overrides
# GEMMA_ENDPOINT=
# DEEPSEEK_ENDPOINT=
# GPT_ENDPOINT=
# QWEN_CODER_ENDPOINT=
# QWEN_EMB_ENDPOINT=

# OpenWeather (optional for Impact Analyzer)
# OPENWEATHER_API_KEY=
# OPENWEATHER_BASE_URL=
